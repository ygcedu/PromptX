# PromptX Web Environment Variables

# API Base URL for PromptX MCP Server
# Development mode (MCP server dev): http://localhost:8848
# Production mode: http://localhost:5203
VITE_API_BASE_URL=http://localhost:8848

# Development settings
VITE_APP_TITLE=PromptX Web
VITE_APP_VERSION=1.25.2

# Enable/disable features
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_AUTO_REFRESH=true
VITE_REFRESH_INTERVAL=30000

# Production mode - using real MCP server data
# Make sure MCP server is running:
# cd packages/mcp-server && pnpm dev